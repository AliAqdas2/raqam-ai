# ─── Convex ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── AI Model Provider (OpenAI Agents SDK + Gemini backend) ────────────────
# The OpenAI Agents SDK is used for agent orchestration, but the underlying
# LLM is Google Gemini via its OpenAI-compatible API endpoint.
# IMPORTANT: This key must be set in the Convex deployment environment
# (Convex Dashboard → Settings → Environment Variables, or via CLI):
#   npx convex env set GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
# Convex actions run server-side and read env vars from the deployment, not .env.local.
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Vision / OCR (Phase 11) ────────────────────────────────────────────────
GOOGLE_CLOUD_VISION_API_KEY=

# ─── Speech-to-Text (AssemblyAI — primary transcription engine, Phase 11) ────
# Voice input transcribes in this order:
#   AssemblyAI  →  Gemini  →  browser Web Speech API
# AssemblyAI model: "universal-2" — the cheapest AssemblyAI tier and the only
# AssemblyAI model that supports Urdu. Language is auto-detected per recording.
#
# Set this in the CONVEX DEPLOYMENT environment (server-side), NOT in .env.local —
# Convex actions read their own deployment env:
#   npx convex env set ASSEMBLYAI_API_KEY=your-key-here
# Create a key: https://www.assemblyai.com/dashboard/api-keys
# If unset, transcription falls back to Gemini, then the browser's Web Speech API.
ASSEMBLYAI_API_KEY=

# ─── Alert Notifications — Email (Gmail SMTP via Nodemailer) ────────────────
# Sends budget/bill/anomaly alerts by email. Runs from a Convex Node action
# (convex/notifications.ts, "use node"), triggered hourly by convex/crons.ts.
# Set in the CONVEX DEPLOYMENT environment, not .env.local:
#   npx convex env set GMAIL_USER=your-address@gmail.com
#   npx convex env set GMAIL_APP_PASSWORD=your-16-char-app-password
# Requires a Google Account with 2-Step Verification turned on, then an App
# Password generated at https://myaccount.google.com/apppasswords
# (choose app "Mail", device "Other" — paste the 16-char password, no spaces).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Alert Notifications — SMS (AWS End User Messaging) ─────────────────────
# Same alerts, sent to users.phone via AWS End User Messaging SMS (Pinpoint
# SMS Voice V2). Pakistan (+92) sends via a registered alphanumeric Sender ID
# — see docs/DEPLOY.md for the full AWS setup (IAM user, Sender ID
# registration). Convex deployment env, not .env.local:
#   npx convex env set AWS_REGION=us-east-1
#   npx convex env set AWS_ACCESS_KEY_ID=your-iam-access-key-id
#   npx convex env set AWS_SECRET_ACCESS_KEY=your-iam-secret-key
#   npx convex env set AWS_SMS_SENDER_ID=RaqamAI
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SMS_SENDER_ID=

# ─── Text-to-Speech (Azure AI Speech — the assistant's voice) ───────────────
# Spoken replies in chat and the hands-free "Call Raqam" voice call.
# Voices: ur-PK-UzmaNeural / ur-PK-AsadNeural (Urdu), en-US-Ava/Andrew
# MultilingualNeural (English). Free F0 tier = 0.5M characters / month.
# Create a "Speech service" resource in the Azure portal (pricing tier F0),
# then copy KEY 1 and the Location/Region (e.g. eastus, centralindia).
# Set in the CONVEX DEPLOYMENT environment, not .env.local:
#   npx convex env set AZURE_SPEECH_KEY your-key
#   npx convex env set AZURE_SPEECH_REGION eastus
# If unset, the app falls back to the browser's built-in speechSynthesis.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
